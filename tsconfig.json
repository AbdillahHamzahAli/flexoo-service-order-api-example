{
  "compilerOptions": {
    /* Language and environment */
    "target": "ESNext",
    "lib": ["ESNext"],

    /* Modules */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,

    /* Types */
    "types": ["bun-types"],

    /* Type checking */
    "strict": true,
    "skipLibCheck": true,

    /* Interop and emit */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src", "tests", "drizzle.config.ts"]
}
