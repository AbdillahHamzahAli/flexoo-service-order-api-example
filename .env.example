# Runtime
NODE_ENV=development
PORT=3000

# Turso database connection
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-token

# Optional local SQLite-compatible file URL for development
DB_PATH=./data/app.db

# Comma-separated list of allowed browser origins, or * for public access
CORS_ORIGIN=http://localhost:3000

# Rate limit for POST /api/v1/contacts
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000
